#!/usr/bin/env python3
"""Prove the React UI updates without a reload.

Drives headless Chrome over CDP:
  1. load /case/<id>
  2. record the rendered event count and a DOM marker
  3. append a real event server-side (via the Clockwork runtime)
  4. WITHOUT reloading, wait for the event count to increase
  5. assert the new event row appeared and that no navigation occurred

Exits non-zero if the live update does not happen, which is the only claim that
matters for this feature.
"""
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.request

import websocket

CASE = sys.argv[1] if len(sys.argv) > 1 else "CW-2026-0007"
BASE = os.environ.get("CLOCKWORK_UI_BASE", "http://localhost:8899").rstrip("/")
URL = f"{BASE}/case/{CASE}"
PORT = 9223


def start_chrome():
    return subprocess.Popen(
        ["google-chrome", "--headless=new", "--disable-gpu", "--no-sandbox",
         f"--remote-debugging-port={PORT}", "--remote-allow-origins=*",
         "--window-size=1440,900", "about:blank"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ws_url():
    for _ in range(40):
        try:
            tabs = json.load(urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json"))
            for t in tabs:
                if t.get("type") == "page":
                    return t["webSocketDebuggerUrl"]
        except Exception:
            pass
        time.sleep(0.25)
    raise RuntimeError("chrome exposed no page target")


def main():
    proc = start_chrome()
    try:
        ws = websocket.create_connection(ws_url(), timeout=25)
        n = [0]

        def call(method, **params):
            n[0] += 1
            ws.send(json.dumps({"id": n[0], "method": method, "params": params}))
            while True:
                msg = json.loads(ws.recv())
                if msg.get("id") == n[0]:
                    return msg

        def js(expr):
            r = call("Runtime.evaluate", expression=expr, returnByValue=True,
                     awaitPromise=True)
            val = r.get("result", {}).get("result", {})
            if "value" in val:
                return val["value"]
            return None

        call("Page.enable")
        call("Runtime.enable")
        call("Log.enable")
        call("Page.navigate", url=URL)
        time.sleep(3.0)

        # a marker that survives only if the page is never reloaded
        js("window.__cwMarker = 'alive'")
        before = js("document.querySelectorAll('.ev').length")
        upto_before = js(
            "Number((document.querySelector('.card-head .small')||{}).textContent"
            ".replace(/\\D/g,'')) || 0")
        print(f"initial: {before} event rows rendered")

        if not before:
            print("FAIL: no event rows rendered — is the UI built and the case real?")
            return 1

        # append a real event through the runtime, exactly as an agent would
        sys.path.insert(0, "/home/matthew/projects/clockwork")
        os.environ.setdefault(
            "CLOCKWORK_ARTIFACTS", tempfile.mkdtemp(prefix="cw-art-"))
        from clockwork.runtime import Runtime
        rt = Runtime()
        rt.register_agent("livecheck", "agent", "live check",
                          ["produce_evidence", "orbit:defense"])
        rt._append(CASE, "edge_added", "livecheck", {
            "src_id": "ev:route-map", "rel": "SUPPORTS",
            "dst_id": "claim:scope-model",
            "attrs": {"probe": "live-update check"},
        }, orbit="system")
        print("appended 1 event server-side")

        # poll the DOM — no reload, no navigation
        deadline = time.time() + 12
        after = before
        while time.time() < deadline:
            time.sleep(0.5)
            after = js("document.querySelectorAll('.ev').length")
            if after and after > before:
                break

        marker = js("window.__cwMarker")
        status_text = js(
            "((document.querySelector('.live-status .live-label')||{}).textContent||'')")
        newest = js(
            "(([...document.querySelectorAll('.ev')].at(-1)||{}).textContent||'')")

        print(f"after:   {after} event rows rendered")
        print(f"marker:  {marker!r}   (page was not reloaded)")
        print(f"status:  {status_text!r}")
        print(f"newest:  {newest.strip()!r}")

        ok = after and after > before and marker == "alive"
        if not ok:
            print("FAIL: DOM did not update without a reload")
            return 1
        if "livecheck" not in (newest or ""):
            print("WARN: row count grew but newest row is not the appended event")
        print("\nPASS: live update without refresh")
        return 0
    finally:
        proc.terminate()


sys.exit(main())
